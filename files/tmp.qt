func transpose<Nat m, Nat n>(Matrix(m, n) x) returns Matrix(n, m) {
    Matrix(n, m) tx = zeros(n, m);
    Nat i = 0; 
    Nat j = 0;
    ewhile (i < n) {
        ewhile (j < m) {
            tx.update(natToFinLT(j), natToFinLT(i), index(x, natToFinLT(i), natToFinLT(j)));
            i = i + 1;
        }
        j = j + 1;
    }
    return tx;
}