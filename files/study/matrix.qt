type Fin(Nat n) {
    constructor FZ<Nat n> of Fin(n + 1);
    constructor FS<Nat n>(Fin(n) k) of Fin(n + 1); 
}

type Vect(Nat n, Ty t) {
    constructor Nil of Vect(0, t);
    constructor Cons(t head, Vect(n, t) tail) of Vect(1+n, t);
}

