interface FSM a' b {
    resource : a
    resourceConc : a'
    state : b
    idxm : ty -> a -> b -> (ty -> b) -> ty
    action : [(idxm ty a b (ty -> b), (a' -> IO (ty, a')))]
    init : [(c -> a')]
...
}:


record FSM(Ty ta, Ty tb) {
    ta resourceType; 
    tb stateType;
    resourceType this; 
    List(Func(() => Ty t), (stateType stIn, Func(t res => stateType))) actions; 
}
